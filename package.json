{
  "name": "devils-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc --build",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist/server/index.cjs --external:@devvit/web --external:@devvit/web/server --external:@devvit/public-api",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build && vite build --watch"
  },
  "dependencies": {
    "@devvit/public-api": "0.13.8",
    "@devvit/web": "0.13.8",
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^2.0.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.12.29",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "phaser": "^4.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "devvit": "0.13.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "vite": "^6.2.3"
  }
}