    const jumpVel = 550; // We set this earlier: this.player.body.setVelocityY(-550);
    const gravity = 1600; // this.player.body.setGravityY(1600);
    
    // Invert jumpVel to absolute since it's going up
    const gapWidth = Phaser.Math.Between(minWidth, maxWidth);
    
    if (!this.trapFactory.isJumpPossible(gapWidth, gravity, jumpVel, this.currentSpeed)) {
        console.warn(`[Troll/Masocore] Flagged gap of ${gapWidth} as unbeatable. Shortening!`);
        // Max achievable distance calculated by trapFactory
        const timeInAir = (2 * jumpVel) / gravity;
        const maxDist = timeInAir * this.currentSpeed;
        const safeGap = Math.floor(maxDist * 0.85); // 85% of max
        this.lastGeneratedX += safeGap;
    } else {
        this.lastGeneratedX += gapWidth;
    }
  }
"""

