<file path="import_assets.py">
import os
import shutil
import sys

DOWNLOADS_DIR = os.path.expanduser("~/Downloads")
PROJECT_PUBLIC_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "public")

print("====================================================")
print("     DEVIL'S RUN: GOTHICVANIA SMART ASSET IMPORTER  ")
print("====================================================")

if not os.path.exists(DOWNLOADS_DIR):
    print(f"Error: Could not locate Downloads at {DOWNLOADS_DIR}")
    sys.exit(1)

png_files = []
for root, dirs, files in os.walk(DOWNLOADS_DIR):
    for file in files:
        if file.lower().endswith(".png"):
            png_files.append(os.path.join(root, file))

def prompt_select_file(target_name, keywords, exclude_keywords=[]):
    candidates = [f for f in png_files if all(k in f.lower() for k in keywords) and not any(e in f.lower() for e in exclude_keywords)]
    if not candidates:
        return None
    if len(candidates) == 1:
        return candidates[0]
    
    print(f"\nMultiple matches for '{target_name}':")
    for idx, cand in enumerate(candidates[:8]):
        print(f" [{idx + 1}] {os.path.basename(cand)}  ({os.path.relpath(cand, DOWNLOADS_DIR)})")
    print(f" [0] Skip")
    
    try:
        choice = int(input(f"Select file for {target_name} (0-{min(len(candidates), 8)}): "))
        if 0 < choice <= len(candidates):
            return candidates[choice - 1]
    except ValueError:
        pass
    return None

# Mapping exactly what the game needs to the Gothicvania files
mappings = [
    ("wizard.png", ["wizard", "idle"], ["attack", "death", "hurt"]),
    ("door.png", ["door"], ["open", "bg"]),
    ("fire_ball.png", ["fireball"], ["impact", "explosion"]),
    ("coin_tile.png", ["gem", "coin", "item"], ["bg", "tileset"]),
    ("spring_tile.png", ["mushroom", "spring", "bounce"], ["bg"]),
    ("hero_idle.png", ["hero", "idle"], ["attack", "jump", "run"]),
    ("hero_run_sheet.png", ["hero", "run"], ["attack", "jump", "idle"]),
    ("hero_jump.png", ["hero", "jump"], ["attack", "idle", "run"]),
    ("well_sprite.png", ["well"], []),
]

copied_count = 0
for target_name, keywords, exclude in mappings:
    source_file = prompt_select_file(target_name, keywords, exclude)
    if source_file:
        shutil.copy(source_file, os.path.join(PROJECT_PUBLIC_DIR, target_name))
        print(f"✅ Imported {target_name}")
        copied_count += 1
    else:
        print(f"⚠️ Skipped {target_name}")

print(f"\nDone! Imported {copied_count} polished assets.")
