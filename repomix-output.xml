  goToMainMenu(): void {
    this.cameras.main.fade(200, 9, 9, 11);
    this.cameras.main.once("camerafadeoutcomplete", () => {
      window.dispatchEvent(new CustomEvent("game-start"));
      this.scene.start("MainMenu");
    });
  }
}
