  height: 100dvh; 
  background-color: #030102;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  overscroll-behavior: none; 
}

#root {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

#app-shell {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #030102;
